# FIXONEX website — environment scaffolding
# Copy to `.env.local` for local development. Never commit `.env.local`.

# -----------------------------------------------------------------------------
# Optional: public site URL (used if you add absolute OG URLs or sitemaps later)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# -----------------------------------------------------------------------------
# Web3Forms (contact, catalog request, partner inquiry)
# Create keys at https://web3forms.com and paste them in .env.local
# For GitHub Pages, also add the same names as repository Actions secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_CATALOG_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_PARTNER_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Optional: analytics (only if you add a provider)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=

# Forms post to Web3Forms. Local: fill the keys above and restart `npm run dev`.
# Production: set the same names as GitHub Actions secrets so `npm run build` can inline them.
